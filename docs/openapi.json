{
    "openapi": "3.1.0",
    "info": {
        "title": "TREC-COVID Search API",
        "description": "M\u00e1quina de busca sobre a cole\u00e7\u00e3o CORD-19 / TREC-COVID (round 1), com os modelos Vetorial TF-IDF e BM25 do HO03 indexados no Elasticsearch.",
        "version": "1.0.0"
    },
    "paths": {
        "/": {
            "get": {
                "tags": [
                    "info"
                ],
                "summary": "Root",
                "operationId": "root__get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "info"
                ],
                "summary": "Health",
                "operationId": "health_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/search": {
            "get": {
                "tags": [
                    "busca"
                ],
                "summary": "Search Endpoint",
                "operationId": "search_endpoint_search_get",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Texto da consulta",
                            "title": "Q"
                        },
                        "description": "Texto da consulta"
                    },
                    {
                        "name": "model",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "enum": [
                                "bm25",
                                "tfidf"
                            ],
                            "type": "string",
                            "description": "Modelo de ranqueamento",
                            "default": "bm25",
                            "title": "Model"
                        },
                        "description": "Modelo de ranqueamento"
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 100,
                            "minimum": 1,
                            "description": "Resultados por p\u00e1gina",
                            "default": 10,
                            "title": "Size"
                        },
                        "description": "Resultados por p\u00e1gina"
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Deslocamento (pagina\u00e7\u00e3o)",
                            "default": 0,
                            "title": "Offset"
                        },
                        "description": "Deslocamento (pagina\u00e7\u00e3o)"
                    },
                    {
                        "name": "highlight",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "description": "Retorna trechos destacados",
                            "default": true,
                            "title": "Highlight"
                        },
                        "description": "Retorna trechos destacados"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/documents/{docno}": {
            "get": {
                "tags": [
                    "busca"
                ],
                "summary": "Document",
                "operationId": "document_documents__docno__get",
                "parameters": [
                    {
                        "name": "docno",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Docno"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/topics": {
            "get": {
                "tags": [
                    "avalia\u00e7\u00e3o"
                ],
                "summary": "Topics",
                "operationId": "topics_topics_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/evaluate": {
            "get": {
                "tags": [
                    "avalia\u00e7\u00e3o"
                ],
                "summary": "Evaluate",
                "description": "Reproduz o pt.Experiment do HO03: MAP, nDCG e cortes @1, @3, @5, @10.",
                "operationId": "evaluate_evaluate_get",
                "parameters": [
                    {
                        "name": "model",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "enum": [
                                "bm25",
                                "tfidf",
                                "all"
                            ],
                            "type": "string",
                            "default": "all",
                            "title": "Model"
                        }
                    },
                    {
                        "name": "depth",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Profundidade do ranking avaliado",
                            "title": "Depth"
                        },
                        "description": "Profundidade do ranking avaliado"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/index": {
            "post": {
                "tags": [
                    "indexa\u00e7\u00e3o"
                ],
                "summary": "Start Indexing",
                "description": "(Re)indexa toda a cole\u00e7\u00e3o em segundo plano.",
                "operationId": "start_indexing_index_post",
                "responses": {
                    "202": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/index/status": {
            "get": {
                "tags": [
                    "indexa\u00e7\u00e3o"
                ],
                "summary": "Indexing Status",
                "operationId": "indexing_status_index_status_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
