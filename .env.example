# ---- Elasticsearch ----
ES_PORT=9200
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ---- API (backend) ----
API_PORT=8000
# URL de conexão da API com o Elasticsearch (nome do serviço na rede do compose)
ELASTICSEARCH_URL=http://elasticsearch:9200
ES_INDEX=trec-covid-round1
DATASET_ID=cord19/trec-covid/round1
# Indexa automaticamente na subida caso o índice não exista
AUTO_INDEX=true
# Profundidade padrão do ranking na avaliação (MAP/nDCG)
EVAL_DEPTH=1000
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=*

# ---- Frontend ----
FRONTEND_PORT=8080
# URL da API vista pelo navegador (em produção, a URL pública da API)
API_URL=http://localhost:8000
