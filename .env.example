# URL que a API usa para falar com o Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ES_INDEX=trec-covid
# Quantos documentos por consulta são considerados na avaliação (MAP/nDCG)
EVAL_DEPTH=1000

# URL da API que o navegador vai chamar (em produção, a URL pública da API)
API_URL=http://localhost:8000
